// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x"] // Añade "debian-openssl-1.1.x" aquí
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String           @id @default(uuid())
  email                    String           @unique
  name                     String
  lastName                 String           @default("")
  password                 String?
  phone                    String           @default("")
  image                    String
  googleId                 String?          @unique
  provider                 String?          @default("local")
  cart                     ProductForCart[] @relation()
  publicId                 String?          @unique
  emailVerified            Boolean          @default(false)
  emailVerificationCode    String           @default("")
  emailVerificationExpires DateTime         @default(now())

  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt()
  orders    Order[]    @relation("UserOrders")
  BlogViews BlogView[] @relation()
}

model finishForProducts {
  productId String
  finishId  String
  finish    finish         @relation(fields: [finishId], references: [id], onDelete: Cascade)
  product   GenericProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, finishId])
}

model finish {
  id       String              @id @default(uuid())
  text     String
  image    String
  publicId String?             @unique
  products finishForProducts[] @relation()
}

model ProductForCart {
  productId String
  userId    String
  User      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   SpecificProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model GenericProduct {
  id          String              @id @default(uuid())
  name        String
  description String              @default("") @db.LongText
  subtitle    String
  typology    String              @default("Variable")
  vector      String              @default("")
  vPublicId   String?
  categoryId  String              @default("2b11c629-841f-11f0-8f51-02006ca180b4")
  variants    SpecificProduct[]   @relation()
  details     Details[]           @relation()
  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  finish      finishForProducts[] @relation()
}

model Category {
  id               String             @id @default(uuid())
  nombre           String             @unique
  productos        GenericProduct[]   @relation()
  CategoryforPromo CategoryforPromo[] @relation()
}

model Details {
  id     String         @id @default(uuid())
  idProd String
  text   String
  prod   GenericProduct @relation(fields: [idProd], references: [id], onDelete: Cascade)
}

model TokenBlacklist {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime @default(now())
  tid       String   @unique
}

model Color {
  id       String            @id @default(uuid())
  name     String
  image    String
  publicId String?           @unique
  products SpecificProduct[] @relation()
}

model SpecificProduct {
  id             String                @id @default(uuid())
  genericId      String
  image          String
  price          Float
  colorId        String
  position       Int                   @default(0)
  stock          Int                   @default(0)
  order          ProductForOrder[]     @relation()
  promotions     ProductForPromotion[] @relation()
  genericProd    GenericProduct        @relation(fields: [genericId], references: [id], onDelete: Cascade)
  images         Images[]              @relation()
  ProductForCart ProductForCart[]      @relation()
  color          Color                 @relation(fields: [colorId], references: [id], onUpdate: Cascade)
  PromoBanner    PromoBanner[]         @relation()
  models3D       Model3D[]             @relation()
}

model Model3D {
  id       String          @id @default(uuid())
  url      String
  publicId String?         @unique
  position Int             @default(0)
  prodId   String
  product  SpecificProduct @relation(fields: [prodId], references: [id], onDelete: Cascade)
}

//TODO: Hacer el publicId obligatorio en Images, Users, Color y finish
model Images {
  id       String          @id @default(ulid())
  position Int             @default(0)
  link     String
  prodId   String
  publicId String?         @unique
  product  SpecificProduct @relation(fields: [prodId], references: [id], onDelete: Cascade)
}

model Order {
  id        String            @id @default(uuid())
  userId    String
  name      String            @default("")
  lastName  String            @default("")
  email     String            @default("")
  phone     String            @default("")
  address   String            @default("")
  province  String            @default("")
  city      String            @default("")
  note      String            @default("")
  delivery  Boolean           @default(false)
  price     Float             @default(0)
  delPrice  Float             @default(0)
  state     String            @default("Pendiente")
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], "UserOrders", onDelete: Cascade)
  products  ProductForOrder[] @relation("OrderProducts")
}

model ProductForOrder {
  orderId   String
  productId String
  count     Int             @default(1)
  order     Order           @relation(fields: [orderId], references: [id], "OrderProducts", onDelete: Cascade)
  product   SpecificProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([orderId, productId])
}

model Promotion {
  promo_id     String                @id @default(uuid())
  startDate    DateTime
  endDate      DateTime
  name         String
  description  String                @default("")
  discountType String
  discount     Float
  Type         String
  products     ProductForPromotion[]
  categories   CategoryforPromo[]    @relation()
}

model CategoryforPromo {
  promoId    String
  categoryId String
  promo      Promotion @relation(fields: [promoId], references: [promo_id], onDelete: Cascade)
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promoId, categoryId])
}

model ProductForPromotion {
  productId   String
  promotionId String
  product     SpecificProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  promotion   Promotion       @relation(fields: [promotionId], references: [promo_id], onDelete: Cascade)

  @@id([productId, promotionId])
}

model PromoBanner {
  id          Int              @id @default(autoincrement())
  name        String
  description String
  prodId      String?
  product     SpecificProduct? @relation(fields: [prodId], references: [id], onDelete: Cascade)
  image       String
  publicId    String?
  carouselId  Int
  carousel    Carousel         @relation("BannerForCarousel", fields: [carouselId], references: [id], onDelete: Cascade)
}

model Carousel {
  id      Int           @id() @default(autoincrement())
  name    String        @unique
  banners PromoBanner[] @relation("BannerForCarousel")
}

model BlogView {
  blogId      String
  UserId      String
  viewedAt    DateTime @default(now())
  scrollDepth Int      @default(0)
  timeSpent   Int      @default(0)
  bounced     Boolean  @default(true)
  completed   Boolean  @default(false)
  shares      Int      @default(0)
  linkClicks  Int      @default(0)
  imageClicks Int      @default(0)
  ctaClicks   Int      @default(0)
  User        User     @relation(fields: [UserId], references: [id], onDelete: Cascade)
  Blog        Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@id([blogId, UserId])
}

model UnsignedBlogView {
  id          String   @id @default(uuid())
  blogId      String
  ipAddress   String
  viewedAt    DateTime @default(now())
  scrollDepth Int      @default(0)
  timeSpent   Int      @default(0)
  bounced     Boolean  @default(true)
  completed   Boolean  @default(false)
  shares      Int      @default(0)
  linkClicks  Int      @default(0)
  imageClicks Int      @default(0)
  ctaClicks   Int      @default(0)
  Blog        Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
}

model Blog {
  id           String      @id @default(uuid())
  title        String
  introduction String      @db.LongText
  images       BlogImage[] @relation()

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  Tags             Tags[]             @relation()
  blogContent      blogContent[]      @relation()
  BlogView         BlogView[]         @relation()
  UnsignedBlogView UnsignedBlogView[] @relation()
  BlogTags         BlogTags[]
}

model blogContent {
  id       String @id @default(uuid())
  blogId   String
  text     String @db.LongText
  position Int    @default(0)
  blog     Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)
}

model BlogImage {
  id       String  @id @default(uuid())
  link     String
  publicId String? @unique
  position Int     @default(0)
  blogId   String
  alt      String  @default("")
  blog     Blog    @relation(fields: [blogId], references: [id], onDelete: Cascade)
}

model Tags {
  id       String     @id @default(uuid())
  name     String
  color    String
  BgColor  String
  Blog     Blog?      @relation(fields: [blogId], references: [id])
  blogId   String?
  BlogTags BlogTags[]
}

model BlogTags {
  blogId String
  tagId  String
  blog   Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag    Tags   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
}
